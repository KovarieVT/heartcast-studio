#include <winver.h>

IDI_APPICON ICON "app.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HeartCast"
            VALUE "FileDescription", "HeartCast Studio - Live Streaming Studio"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "HeartCastStudio"
            VALUE "LegalCopyright", "Copyright (C) 2026 HeartCast contributors. GPL-2.0-or-later."
            VALUE "OriginalFilename", "HeartCastStudio.exe"
            VALUE "ProductName", "HeartCast Studio"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
